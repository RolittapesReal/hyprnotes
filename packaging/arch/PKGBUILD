# Maintainer: Hyprnotes contributors
# Built from a local source tarball by packaging/build-package.sh (which fills in sha256sums).
pkgname=hyprnotes
pkgver=0.1.0
pkgrel=1
pkgdesc='Markdown notes and sticky notes for Hyprland (Qt6)'
arch=('x86_64')
url='https://example.invalid/hyprnotes'  # release owner: set the real project URL
license=('MIT')
# Direct NEEDED libs of /usr/bin/hyprnotes: Qt6{Core,Gui,Widgets,Network,Sql,Svg}, md4c, libGLX/libOpenGL, libstdc++, libgcc_s, libc.
# SQLite is used through Qt's qsqlite plugin (qt6-base depends on sqlite); qt6-wayland supplies the Wayland platform plugin.
depends=('qt6-base' 'qt6-svg' 'qt6-wayland' 'md4c' 'sqlite' 'lua' 'libarchive' 'libglvnd' 'gcc-libs' 'glibc')
makedepends=('cmake' 'ninja')
options=('!debug')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cmake -S "$pkgname-$pkgver" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=None -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build --target hyprnotes
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
